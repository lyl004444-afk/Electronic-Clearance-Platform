@model Electronic_Clearance_Platform.Models.ClearanceRequest

@{
    ViewData["Title"] = "تقديم طلب براءة ذمة جديد";
}

<div class="container mt-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-plus"></i> تقديم طلب براءة ذمة جديد</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">الاسم الكامل</label>
                            <input asp-for="FullName" class="form-control form-control-lg" placeholder="أدخل اسم الطالب أو الموظف الكامل" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">الرقم التعريفي / الجامعي</label>
                            <input asp-for="IdentificationNumber" class="form-control form-control-lg" placeholder="مثال: 20261001" />
                            <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">القسم</label>
                            <input asp-for="Department" class="form-control form-control-lg" placeholder="مثال: علوم الحاسوب" />
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">تاريخ الطلب</label>
                            <input asp-for="RequestDate" class="form-control form-control-lg" type="date" />
                            <span asp-validation-for="RequestDate" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">حالة الطلب</label>
                            <input asp-for="Status" class="form-control form-control-lg" value="قيد المراجعة" readonly />
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3">
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                <i class="bi bi-check-circle"></i> حفظ الطلب
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-4">
                                <i class="bi bi-arrow-right"></i> العودة للقائمة
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}